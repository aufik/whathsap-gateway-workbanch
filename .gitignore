# ==============================================================================
# Git Ignore: WA Bot QA Workbench & Live Chat Gateway
# ==============================================================================

# Kredensial, Rahasia, dan Konfigurasi Lokal
.env
.env.*
!.env.example

# Berkas Binary & Kompilasi
wa-bot-tester
*.exe
*.dll
*.so
*.dylib

# SQLite WhatsApp Session & Protocol Storage (Krusial: Jangan ter-commit)
*.db
*.db-shm
*.db-wal
data/users/*/wa/**

# Berkas Gambar & Media Hasil Pengujian Bot (Krusial: Berat & Dinamis)
*.png
*.jpg
*.jpeg
*.webp
data/downloads/**
!data/downloads/.gitkeep
data/users/*/downloads/**
data/users/*/livechat_media/**
data/users/*/livechat_assets/**

# Berkas Excel Runtime, Cadangan, dan Metrik Sidecar
*.tmp
*.bak
*.tar.gz
*.backup.xlsx
*.backup_tested.xlsx
*.metrics.json
data/users/*/*.xlsx
data/users/*/*.xlsx.tmp
data/users/*/*.metrics.json
data/templates/*.xlsx
!data/templates/.gitkeep

# Direktori Arsip Backup Internal
data/backups_secure/**

# Artifacts & Log
*.log
node_modules/
.dockerignore.bak
*:Zone.Identifier
