HOST=0.0.0.0
PORT=3020
EXCEL_FILE=Uji-Bank-Pertanyaan-Programmer-4.xlsx
WA_SESSION_DB=wa_session.db

# Nomor WhatsApp Bot Target (contoh: 6281234567890)
BOT_PHONE=

# Mode Kalimat Default: exact | natural | chaos | manual
DEFAULT_QUESTION_MODE=natural

# Parameter 8-Tahap Simulasi Manusia Paling Aman (Anti-Spam WA) dalam milidetik
PRE_THINK_MIN_MS=2000
PRE_THINK_MAX_MS=5000
TYPING_MS_PER_CHAR=105
TYPING_MIN_MS=4500
TYPING_MAX_MS=20000
UNREAD_DELAY_MIN_MS=2500
UNREAD_DELAY_MAX_MS=8000
READ_DELAY_MIN_MS=4500
READ_DELAY_MAX_MS=13000
DELAY_MIN_MS=15000
DELAY_MAX_MS=30000
DISTRACTION_SPIKE_PCT=22
DISTRACTION_MIN_MS=32000
DISTRACTION_MAX_MS=60000
COOLDOWN_EVERY_MIN=12
COOLDOWN_EVERY_MAX=18
COOLDOWN_MIN_MS=90000
COOLDOWN_MAX_MS=165000
LONG_REST_EVERY_MIN=40
LONG_REST_EVERY_MAX=50
LONG_REST_MIN_MS=240000
LONG_REST_MAX_MS=420000
QUIET_WINDOW_MS=5500
REPLY_TIMEOUT_MS=35000

# PostgreSQL Multi-User Workbench Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/whathsap-gateway-workbench?sslmode=disable

# Session cookie (gunakan nilai acak 32+ karakter di production)
SESSION_SECRET=change-this-to-a-random-32-character-secret

# Admin awal (dipakai jika database masih kosong)
INITIAL_ADMIN_USERNAME=superadmin_kominfo
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_FULL_NAME=Super Admin Kominfo

# Konfigurasi AI OpenAI-Compatible (Opsional & Gratis: 9router / Gemini Free / Groq Free / Ollama)
